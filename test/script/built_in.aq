p(1 + 3)

def f(n) {
  if (n == 0) {
    ret = 1
  } else {
    ret = n * f(n - 1)
  }
  p(ret)
  ret
}

f(10)

def fizzbuzz(n) {
  if (n / 15 * 15 == n) {
    "fizzbuzz"
  } else if (n / 3 * 3 == n) {
    "fizz"
  } else if (n / 5 * 5 == n) {
    "buzz"
  } else {
    n
  }
}

x = 1
while (x <= 15) {
  y = fizzbuzz(x)
  p(y)
  x = x + 1
}
